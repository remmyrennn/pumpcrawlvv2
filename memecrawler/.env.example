# ============================================================
# MemeCrawler — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Sprint 2 additions are marked with [S2].
# ============================================================

# ── Bot credentials ──────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USERS=123456789,987654321
TARGET_CHAT=-100123456789

# ── API keys ─────────────────────────────────────────────────
HELIUS_API_KEY=

# ── Supabase (Sprint 4) ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Database ─────────────────────────────────────────────────
SQLITE_PATH=memecrawler.db

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Timing ───────────────────────────────────────────────────
# How often the scanner runs a full discovery + scan cycle (seconds).
SCAN_INTERVAL=300
# How often the heartbeat fires (seconds).
HEARTBEAT_INTERVAL=3600

# ── Discovery filters [S2] ────────────────────────────────────
# Minimum liquidity (USD) for a token to pass the discovery filter.
MIN_LIQUIDITY_USD=500.0
# Max tokens to fetch per provider per discovery cycle.
DISCOVERY_LIMIT=50
# Comma-separated mint addresses to always reject.
BLACKLISTED_TOKENS=
# Comma-separated developer wallet addresses to always reject.
BLACKLISTED_DEVELOPERS=

# ── Priority thresholds [S2] ──────────────────────────────────
PRIORITY_CRITICAL_VOLUME=500000
PRIORITY_CRITICAL_LIQUIDITY=100000
PRIORITY_HIGH_VOLUME=100000
PRIORITY_HIGH_LIQUIDITY=50000
PRIORITY_MEDIUM_VOLUME=10000
PRIORITY_MEDIUM_LIQUIDITY=10000

# ── Feature flags ─────────────────────────────────────────────
ENABLE_PUMPFUN=true
ENABLE_DEXSCREENER=true
ENABLE_HELIUS=false
ENABLE_RUGCHECK=true
ENABLE_HEARTBEAT=true
ENABLE_SCANNER=true
ENABLE_SUPABASE_SYNC=false
